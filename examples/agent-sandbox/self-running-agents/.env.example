# Copy to .env (git ignores it) and fill in your own values. The scripts read
# these keys only, and a value already set in your environment wins.
# Values are read as written: no quotes, no comments after the value, LF line endings.
#
#   cp .env.example .env

# Your EKS Auto Mode cluster and its Region. The gateway, the tool function, the
# run bucket and the image repository are created in this Region.
CLUSTER_NAME=
AWS_REGION=us-west-2

# The AWS CLI profile for the account the cluster is in, if it is not your
# default one. Leave it empty to use the CLI's default credentials.
AWS_PROFILE=

# The kube context of the cluster above. Set it so a run never depends on the
# machine's current context.
KUBE_CONTEXT=

# The namespace the agent runs in. setup.sh creates it and labels it as the
# sample's; the admission policy applies to this namespace only.
NAMESPACE=self-running-agents

# The Bedrock inference profile the agent reasons with. The agent's role may
# invoke this profile and the models it routes to, and nothing else.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-5-5

# The prefix of every AWS name the sample creates (roles, the tool function, the
# gateway, the policy engine, the run bucket), and the image repository.
NAME_PREFIX=self-running-agents
ECR_REPOSITORY=self-running-agents

# The run bucket. Left empty it is <NAME_PREFIX>-runs-<account id>-<Region>.
RUN_BUCKET=

# The kubectl to call. Leave it as kubectl unless you use a wrapper.
KUBECTL=kubectl
