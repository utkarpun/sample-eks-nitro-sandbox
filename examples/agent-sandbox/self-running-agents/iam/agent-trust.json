{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "pods.eks.amazonaws.com" },
      "Action": ["sts:AssumeRole", "sts:TagSession"],
      "Condition": { "StringEquals": { "aws:SourceAccount": "<ACCOUNT_ID>", "aws:RequestTag/eks-cluster-arn": "arn:aws:eks:<AWS_REGION>:<ACCOUNT_ID>:cluster/<CLUSTER_NAME>", "aws:RequestTag/kubernetes-namespace": "<NAMESPACE>", "aws:RequestTag/kubernetes-service-account": "agent" } }
    }
  ]
}
